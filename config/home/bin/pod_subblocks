join -1 3 -2 1 \
    <(kubectl get pods -o "custom-columns=NAME:.metadata.name,NAMESPACE:.metadata.namespace,NODE:.spec.nodeName" "$@" | sort -b -k 3) \
    <(kubectl get nodes -o 'go-template={{ range .items }}{{ .metadata.name }} {{ with index .metadata.labels "cloud.google.com/gce-topology-block" }}{{ . }}{{ else }}{{ "none" }}{{ end }} {{ with index .metadata.labels "cloud.google.com/gce-topology-subblock" }}{{ . }}{{ else }}{{ "none" }}{{ end }}{{ "\n" }}{{ end }}' --no-headers | sort -b) \
    | sort -k 4,5
